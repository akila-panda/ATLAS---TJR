# PostgreSQL 
POSTGRES_USER=atlas_user 
POSTGRES_PASSWORD=change_me_strong_password 
POSTGRES_DB=atlas 
DATABASE_URL=postgresql://atlas_user:change_me_strong_password@postgres:5432/atlas 
 
# Redis 
REDIS_URL=redis://redis:6379 
 
# API security key — generate a random 32-char string 
ATLAS_API_KEY=change_me_32_char_api_key_here_xx 
 
# App settings 
NODE_ENV=development 
FRONTEND_ORIGIN=http://localhost:5173 
SIGNAL_ENGINE_URL=http://signal-engine:8001 
LOG_LEVEL=debug 
 
# ATLAS trading mode: MANUAL (signals shown, you confirm) or AUTO (executes automatically) 
# Always start with MANUAL until you have verified at least 10 correct signals 
ATLAS_MODE=MANUAL 
 
# Your broker account balance in USD (used for position sizing: lot = balance * 0.01 / sl_pips / 10) 
ACCOUNT_BALANCE=100000 
 
# Frontend env vars (Vite requires VITE_ prefix) 
VITE_API_URL=http://localhost:3001 
VITE_WS_URL=http://localhost:3001 
VITE_API_KEY=change_me_32_char_api_key_here_xx 
